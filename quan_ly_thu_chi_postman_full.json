            "url": {
              "raw": "{{base_url}}/api/v1/users/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leminhdang\",\n  \"email\": \"leminhdang@uit.edu.vn\",\n  \"password\": \"123123123a\",\n  \"passwordConfirm\": \"123123123a\",\n  \"name\": \"Lê Minh Đăng\",\n  \"birthday\": \"2001-10-16\",\n  \"phoneNumber\": \"0876838874\",\n  \"address\": \"UIT, Thủ Đức, TP.HCM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "02. Đăng nhập (Auto Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.access) { pm.collectionVariables.set('access_token', d.access); console.log('Auto saved access_token'); }",
                  "if (d.refresh) { pm.collectionVariables.set('refresh_token', d.refresh); console.log('Auto saved refresh_token'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "description": "Đăng nhập lấy JWT. Script tự lưu access_token + refresh_token.",
            "url": {
